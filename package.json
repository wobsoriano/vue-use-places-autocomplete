{
  "name": "vue-use-places-autocomplete",
  "type": "module",
  "version": "0.3.0",
  "packageManager": "pnpm@10.18.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wobsoriano/vue-use-places-autocomplete.git"
  },
  "keywords": [
    "vue",
    "places",
    "autocomplete"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
