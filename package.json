    "@antfu/eslint-config": "^5.4.1",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^20.16.2",
    "bumpp": "^10.3.0",
    "eslint": "^9.36.0",
    "jsdom": "^25.0.0",
    "tsdown": "^0.15.6",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.22",
    "vue-composable-testing": "^0.2.0"
